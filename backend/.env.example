# Application Settings
APP_NAME="Graph Data Modeling System"
APP_VERSION="1.0.0"
DEBUG=False

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/graphdb

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Settings
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# Query Settings
QUERY_TIMEOUT=30
MAX_QUERY_RESULTS=1000
RATE_LIMIT_PER_MINUTE=10

# Graph Settings
INITIAL_NODE_LIMIT=500
MAX_EXPANSION_DEPTH=2
GRAPH_PICKLE_PATH=backend/graph.pickle

# CORS Settings (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Bring-your-own-database (hosted prototype) ---
# Shared secret users must enter to open a connection. Set this on any public deployment.
ACCESS_CODE=
# Set true ONLY when running behind a trusted reverse proxy (Railway, nginx) so rate limits see real client IPs
TRUST_PROXY_HEADERS=false
# Local development only: allow localhost/private-network databases and SQLite files
ALLOW_PRIVATE_HOSTS=false
ALLOW_SQLITE_CONNECTIONS=false
CONNECT_RATE_LIMIT_PER_MINUTE=5
SESSION_TTL_MINUTES=30
MAX_SESSIONS=20
MAX_TABLES=100
MAX_ROWS_PER_TABLE=200
MAX_GRAPH_NODES=5000
